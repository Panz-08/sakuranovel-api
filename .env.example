# Port untuk server lokal (Vercel mengabaikan ini)
PORT=3000

# Basis situs sumber. Jangan ubah kecuali kamu tahu risikonya.
SAKURANOVEL_BASE_URL=https://sakuranovel.id

# Cache di memori fungsi (detik). Vercel juga memakai cache CDN.
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=500

# Batas request per menit per IP (per instance fungsi).
RATE_LIMIT_PER_MINUTE=120

# Timeout request ke API sumber (ms).
UPSTREAM_TIMEOUT_MS=12000

# User-Agent yang jelas. Ganti dengan URL repo/kontak milikmu bila sudah ada.
USER_AGENT=SakuraNovelAPI/1.0 (metadata-only; creator: panz-08)
